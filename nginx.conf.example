# ======================================================================
# Nginx Reverse Proxy & SSL Configuration for USeP OBE Studio
# Target File: /etc/nginx/sites-available/usep-obe.conf
# ======================================================================

# HTTP server block: Redirects all insecure traffic to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name syllabus.usep.edu.ph;

    return 301 https://$host$request_uri;
}

# HTTPS server block: Production Reverse Proxy with SSL termination
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name syllabus.usep.edu.ph;

    # SSL Certificate Paths (Managed by Let's Encrypt Certbot)
    ssl_certificate /etc/letsencrypt/live/syllabus.usep.edu.ph/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/syllabus.usep.edu.ph/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Match Flask MAX_CONTENT_LENGTH (25 MB upload limit for syllabus Word/PDF files)
    client_max_body_size 25M;

    # Hardened Security Headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Direct static file serving for maximum throughput
    location /static/ {
        alias /var/www/usep-obe/static/;
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
    }

    # Proxy traffic to Gunicorn WSGI server
    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 120s buffer timeouts for intensive PDF/Excel synthesis operations
        proxy_connect_timeout 120s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_buffering on;
        proxy_buffers 8 16k;
        proxy_buffer_size 32k;
    }
}
