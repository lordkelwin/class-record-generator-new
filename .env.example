# ======================================================================
# USeP OBE Syllabus-to-Class Record Generator - Environment Configuration
# ======================================================================
# Copy this file to .env to customize local server and database options.

# Network Binding
# 0.0.0.0 binds to all network interfaces, allowing both localhost
# and LAN IP access (e.g., http://192.168.x.x:5000) for multi-user client UAT.
HOST=0.0.0.0
PORT=5000
DEBUG=false

# Database & Storage Directories (Leave commented to use default ./data)
# DATA_DIR=data
# DATABASE_PATH=data/academic_catalog.db
# USERS_JSON_PATH=data/users.json
# STUDENTS_JSON_PATH=data/students.json
# COURSES_DIR=data/courses
# SECRET_KEY_FILE=data/secret_key

# Microsoft Access Curriculum Database (Leave commented to use ./prospectus/PGO-PI-IGA.accdb)
# ACCDB_PATH=prospectus/PGO-PI-IGA.accdb
# ACCDB_CONN_STR=DRIVER={Microsoft Access Driver (*.mdb, *.accdb)};DBQ=prospectus/PGO-PI-IGA.accdb;

# Typography & Fonts
# FONTS_DIR=fonts
# CINZEL_FONT_PATH=fonts/Cinzel-Bold.otf
